{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "Context For Humans",
  "version": "0.1.0",
  "description": "Collect conversation links and organize them into project graphs.",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/brain.png",
    "32": "icons/brain.png",
    "48": "icons/brain.png",
    "128": "icons/brain.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Context For Humans",
    "default_icon": {
      "16": "icons/brain.png",
      "32": "icons/brain.png",
      "48": "icons/brain.png",
      "128": "icons/brain.png"
    }
  },
  "side_panel": {
    "default_path": "pages/sidepanel.html"
  }
}
